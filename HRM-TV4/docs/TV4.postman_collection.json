{
  "info": {
    "name": "TV4 v2 — Nghỉ phép và phê duyệt",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy trên demo riêng. Đăng nhập 3 role, lấy loại nghỉ, chọn ngày published chưa trùng. Không chạy ghi dữ liệu trên database thật ngoài phạm vi được phép."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "employeeToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "hrToken",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "annualId",
      "value": ""
    },
    {
      "key": "unpaidId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "fromDate",
      "value": "2026-11-09"
    },
    {
      "key": "toDate",
      "value": "2026-11-10"
    }
  ],
  "item": [
    {
      "name": "01 — Đăng nhập ba vai trò",
      "item": [
        {
          "name": "Đăng nhập employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"employee\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('employeeToken', data.token);",
                  "pm.collectionVariables.set('employeeId', data.user.employeeId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('managerToken', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập hr",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"hr\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('hrToken', data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Loại nghỉ",
      "item": [
        {
          "name": "Lấy loại và lưu ID mẫu",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/leave-types"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json().data;",
                  "const annual = rows.find(x => x.code === 'ANNUAL');",
                  "const unpaid = rows.find(x => x.code === 'UNPAID');",
                  "if (annual) pm.collectionVariables.set('annualId', annual.id);",
                  "if (unpaid) pm.collectionVariables.set('unpaidId', unpaid.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "HR tạo loại nghỉ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/leave-types",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SPECIAL_DEMO\",\n  \"name\": \"Nghỉ đặc biệt\",\n  \"paid\": true,\n  \"annualQuota\": 3,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "03 — Gửi và xử lý đơn",
      "item": [
        {
          "name": "Xem trước, không lưu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/leave-requests/preview",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveTypeId\": \"{{annualId}}\",\n  \"fromDate\": \"{{fromDate}}\",\n  \"toDate\": \"{{toDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Nhân viên gửi đơn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/leave-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveTypeId\": \"{{annualId}}\",\n  \"fromDate\": \"{{fromDate}}\",\n  \"toDate\": \"{{toDate}}\",\n  \"reason\": \"Giải quyết việc gia đình\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tạo pending', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "if (data) pm.collectionVariables.set('requestId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Chi tiết đơn",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/leave-requests/{{requestId}}"
          }
        },
        {
          "name": "Danh sách pending theo quyền",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ],
            "url": "{{baseUrl}}/leave-requests?status=pending"
          }
        },
        {
          "name": "Manager duyệt đơn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/leave-requests/{{requestId}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Đồng ý cho nghỉ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Số dư sau duyệt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/leave-balances/{{employeeId}}?year=2026"
          }
        },
        {
          "name": "HR hủy đơn đã duyệt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/leave-requests/{{requestId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Nhân viên xác nhận không nghỉ nữa\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Số dư sau hủy",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": "{{baseUrl}}/leave-balances/{{employeeId}}?year=2026"
          }
        }
      ]
    },
    {
      "name": "04 — Dữ liệu công/lương",
      "item": [
        {
          "name": "Ngày approved cho TV3/TV5",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hrToken}}"
              }
            ],
            "url": "{{baseUrl}}/leave-approved-days?employeeId={{employeeId}}&from=2026-11-01&to=2026-11-30"
          }
        }
      ]
    }
  ]
}
