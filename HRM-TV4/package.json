{
  "name": "hrm-tv4-leave",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "demo": "concurrently -k \"npm run demo -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm run test -w server && npm run test -w client",
    "seed": "npm run seed -w server",
    "test:unit": "npm run test:unit -w server",
    "test:integration": "npm run test:integration -w server",
    "test:api": "npm run test:api -w server",
    "test:ui": "npm run test -w client",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
